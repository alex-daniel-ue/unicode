[node name="ITThreeRepeatExactlyN" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
instructions = "These three classrooms all look the same, but don't be fooled — count carefully! Use \"declare var ... as ...\", \"while\", and \"increment\" to build your own counting loop. Move forward exactly the right number of times to land on the marked desk. Your program has to work in all three rooms, so no shortcuts — build a loop that actually counts."
intended_solution = "block: BeginBlock
  text: \"begin code\"
  children:
    - block: DeclareAsBlock
      text: \"declare var {} as {}\"
      parameters:
        - \"i\"
        - 0
    - block: WhileBlock
      text: \"while {}\"
      parameters:
        - block: ComparisonBlock
          text: \"{} {} {}\"
          parameters:
            - \"i\"
            - \"<\"
            - 3
      children:
        - block: MoveBlock
          text: \"move forward\"
        - block: IncrementBlock
          text: \"increment {}\"
          parameters:
            - \"i\"
"
room_goals = [null]

