[node name="VAR8GoodNames" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - first
        - \"input ( )\"  # not a readable value
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - last
        - \"input ( )\"  # not a readable value
    - block: PrintBlock
      kind: statement
      text: \"print {}\"
      parameters:
        - \"{last}, {first}\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]
star_par_override = 3

[node name="LevelDescription" parent="." index="0"]
title = "Good names"
mission = "This program has mistakes in its names, so Python can't run it. Fix the names so that it shows the last name, a comma, and the first name."
rooms = PackedStringArray("The user types Ana and Lee.", "The user types Leo and Grant.")
twist = "Don't add or remove blocks. Only change the names."
tip = "A name starts with a letter or _, and it has no spaces, like first_name."

[node name="LevelBlockPreset" parent="." index="1"]
program = "[[\"declare\", \"1st\", [\"input\"]], [\"declare\", \"last name\", [\"input\"]], [\"print\", \"f\\\"{last name}, {1st}\\\"\"]]"

[node name="GenericBlockProvider" parent="." index="2"]
