[node name="OP7SquaresAndCubes" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - n
        - block: ConvertBlock
          kind: value
          text: \"{} ( {} )\"
          parameters:
            - int
            - \"input ( )\"  # not a readable value
    - block: PrintBlock
      kind: statement
      text: \"print {}\"
      parameters:
        - block: ArithmeticBlock
          kind: value
          text: \"{} {} {}\"
          parameters:
            - n
            - **
            - 2
    - block: PrintBlock
      kind: statement
      text: \"print {}\"
      parameters:
        - block: ArithmeticBlock
          kind: value
          text: \"{} {} {}\"
          parameters:
            - n
            - **
            - 3"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

