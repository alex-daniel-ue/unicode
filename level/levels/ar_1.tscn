[node name="AR1MeetAList" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: MoveTilesBlock
      kind: statement
      text: \"move forward {} times\"
      parameters:
        - block: ItemOfBlock
          kind: value
          text: \"item {} of {}\"
          parameters:
            - 0
            - route
    - block: TurnBlock
      kind: statement
      text: \"turn {}\"
      parameters:
        - left
    - block: MoveTilesBlock
      kind: statement
      text: \"move forward {} times\"
      parameters:
        - block: ItemOfBlock
          kind: value
          text: \"item {} of {}\"
          parameters:
            - 1
            - route"
room_goals = [NodePath("RoomGoals/GoalManager")]
auto_run = true
minimal_ui = true

[node name="LevelDescription" parent="." index="0"]
title = "Meet a list"
mission = "Watch the robot use the list on the wall to find the flag."
blocks = Array[ExtResource("4_block_data")]([ExtResource("18_item_of"), ExtResource("19_move_n")])
block_notes = PackedStringArray("Gives you the value at an index.", "Moves forward that many times.")
tip = "In Python, this list is written route = [2, 3]."
show_stars = false

[node name="LevelBlockPreset" parent="." index="1"]
