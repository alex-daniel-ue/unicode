[node name="AR1ReadTheCard" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: MoveTilesBlock
      kind: statement
      text: \"move forward {}\"
      parameters:
        - block: ItemOfBlock
          kind: value
          text: \"item {} of {}\"
          parameters:
            - 0
            - route
    - block: TurnBlock
      kind: statement
      text: \"turn {}\"
      parameters:
        - left
    - block: MoveTilesBlock
      kind: statement
      text: \"move forward {}\"
      parameters:
        - block: ItemOfBlock
          kind: value
          text: \"item {} of {}\"
          parameters:
            - 1
            - route"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

[node name="LevelDescription" parent="." index="0"]
title = "Read the card"
mission = "One program, three rooms. The card on the wall gives the way to the flag: walk its first number of tiles, turn left, then walk its second number."
rooms = PackedStringArray("A wide room.", "A tall room.", "A long, low room.")
twist = "But the card says something different in every room."
blocks = Array[ExtResource("3_block_data")]([ExtResource("17_item_of"), ExtResource("18_move_n")])
block_notes = PackedStringArray("Here it reads one number off the card. It gives the item at a position in a list, and positions start at 0.", "Here the robot walks as far as a number says. It moves forward that many tiles, one at a time.")
tip = "In Python, item 0 of route is written route[0]."

