script = ExtResource("8_block_data")
name = "ForBlock (Integer)"
color = Color(0.37254903, 0.5176471, 0.72156864, 1)
base_path = "res://puzzle/ui/block/templates/nested/nested_block.tscn"
type = 1
nested = SubResource("Nest_1")
category = "Iterative"
syntax = "for var {name: variable}, from {start: int/variable} to {end: int/variable}, step {increment: int}"
description = "Iterates from a start value to an end value (inclusive), adding the step value each time. Creates a local variable for the index."
text = "for var {}, from {}\\nto {}, at step {}"
text_blocks = Array[ExtResource("8_block_data")]([SubResource("BD_4"), SubResource("BD_7"), SubResource("BD_10"), SubResource("BD_13")])
Type/nested = SubResource("Nest_1")
Function/script = ExtResource("9_control_flow")
Function/method = &"_for"
metadata/_custom_type_script = "uid://dbo3fa8pswxeg"

