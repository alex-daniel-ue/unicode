[node name="IT7AisleByAisle" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForBlock (Integer)
      kind: nested
      text: \"for var {}, from {}\\nto {}, at step {}\"
      locked: true
      parameters:
        - a
        - 1
        - 3
        - 1
      children:
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - left
        - block: ForBlock (Integer)
          kind: nested
          text: \"for var {}, from {}\\nto {}, at step {}\"
          parameters:
            - s
            - 1
            - 3
            - 1
          children:
            - block: MoveBlock
              kind: statement
              text: \"move forward\"
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - back
        - block: ForBlock (Integer)
          kind: nested
          text: \"for var {}, from {}\\nto {}, at step {}\"
          parameters:
            - s
            - 1
            - 3
            - 1
          children:
            - block: MoveBlock
              kind: statement
              text: \"move forward\"
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - left
        - block: ForBlock (Integer)
          kind: nested
          text: \"for var {}, from {}\\nto {}, at step {}\"
          parameters:
            - s
            - 1
            - 2
            - 1
          children:
            - block: MoveBlock
              kind: statement
              text: \"move forward\"
    - block: TurnBlock
      kind: statement
      text: \"turn {}\"
      parameters:
        - left
    - block: MoveBlock
      kind: statement
      text: \"move forward\""
room_goals = [NodePath("RoomGoals/GoalManager")]
star_slack = 3

[node name="Header" type="Label" parent="LevelDescription" index="0"]
visible = false
theme_type_variation = &"HeaderMedium"
text = "Aisle by aisle"
horizontal_alignment = 1

[node name="Line1" type="Label" parent="LevelDescription" index="1"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "Nine pens on the floor, three aisles, one door. Driving over a pen picks it up."
autowrap_mode = 3

[node name="Line2" type="Label" parent="LevelDescription" index="2"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "Every aisle is identical: go up it, come back down, step across to the next one."
autowrap_mode = 3

[node name="Line3" type="Label" parent="LevelDescription" index="3"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "So there are two sizes of repetition here. The steps inside one aisle, and the aisles themselves. That's a loop inside a loop."
autowrap_mode = 3

[node name="Line4" type="Label" parent="LevelDescription" index="4"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "The outer for is placed and locked. Build one aisle inside it and let it repeat."
autowrap_mode = 3

[node name="Inert5" parent="LevelDescription" index="5" instance=ExtResource("3_statement")]
visible = false
offset_right = 140.0
data = ExtResource("4_turn")

[node name="Line6" type="Label" parent="LevelDescription" index="6"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "turn back is two left turns in one block."
autowrap_mode = 3

[node name="Line7" type="Label" parent="LevelDescription" index="7"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "Careful with names. If you call both counters i, the inner one collides with the outer one and the game says so. Give them different names, and watch both in the Variables tab."
autowrap_mode = 3

[node name="Line8" type="Label" parent="LevelDescription" index="8"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "One last turn and step after the loop puts the robot on the door."
autowrap_mode = 3

[node name="Line9" type="Label" parent="LevelDescription" index="9"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "3 stars: 11 blocks."
autowrap_mode = 3

