[node name="IT7AisleByAisle" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForBlock (Integer)
      kind: nested
      text: \"for var {}, from {}\\nto {}, at step {}\"
      locked: true
      parameters:
        - a
        - 1
        - 3
        - 1
      children:
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - left
        - block: ForBlock (Integer)
          kind: nested
          text: \"for var {}, from {}\\nto {}, at step {}\"
          parameters:
            - s
            - 1
            - 3
            - 1
          children:
            - block: MoveBlock
              kind: statement
              text: \"move forward\"
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - back
        - block: ForBlock (Integer)
          kind: nested
          text: \"for var {}, from {}\\nto {}, at step {}\"
          parameters:
            - s
            - 1
            - 3
            - 1
          children:
            - block: MoveBlock
              kind: statement
              text: \"move forward\"
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - left
        - block: ForBlock (Integer)
          kind: nested
          text: \"for var {}, from {}\\nto {}, at step {}\"
          parameters:
            - s
            - 1
            - 2
            - 1
          children:
            - block: MoveBlock
              kind: statement
              text: \"move forward\"
    - block: TurnBlock
      kind: statement
      text: \"turn {}\"
      parameters:
        - left
    - block: MoveBlock
      kind: statement
      text: \"move forward\""
room_goals = [NodePath("RoomGoals/GoalManager")]
star_slack = 3

