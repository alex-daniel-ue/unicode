[node name="IT7AroundTheRoom" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForBlock (Integer)
      kind: nested
      text: \"for {} from {} until {}\\ncounting by {}\"
      locked: true
      parameters:
        - side
        - 1
        - 5
        - 1
      children:
        - block: ForBlock (Integer)
          kind: nested
          text: \"for {} from {} until {}\\ncounting by {}\"
          parameters:
            - s
            - 1
            - 5
            - 1
          children:
            - block: MoveBlock
              kind: statement
              text: \"step forward\"
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - left"
room_goals = [NodePath("RoomGoals/GoalManager")]

[node name="LevelDescription" parent="." index="0"]
title = "Around the room"
mission = "Go once around the room and collect every battery. Then stop on the green flag where you started."
twist = "The outer loop is already on the canvas. It makes one pass for each side of the room. You decide what goes inside it."
tip = "A loop can hold another loop. Give each loop a different variable name."

[node name="LevelBlockPreset" parent="." index="1"]
program = "[[\"for\", \"side\", 1, 5, 1]]"

[node name="GenericBlockProvider" parent="." index="2"]
