[node name="IT0bRebuildIt" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: MoveBlock
      kind: statement
      text: \"move forward\"
    - block: MoveBlock
      kind: statement
      text: \"move forward\"
    - block: IfBlock
      kind: nested
      text: \"if {}\"
      parameters:
        - block: NotBlock
          kind: expression
          text: \"not {}\"
          parameters:
            - block: AheadIsBlock
              kind: expression
              text: \"ahead is {}\"
              parameters:
                - puddle
      children:
        - block: MoveBlock
          kind: statement
          text: \"move forward\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

