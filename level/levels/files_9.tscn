[node name="FILES9NumberTheLines" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - n
        - 1
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - line
        - \"poem.txt\"  # not a readable value
      children:
        - block: WriteBlock
          kind: statement
          text: \"write {} to {}\"
          parameters:
            - \"{n}: {line}\"
            - \"numbered.txt\"  # not a readable value
        - block: UpdateBlock
          kind: statement
          text: \"{} {} {}\"
          parameters:
            - n
            - +=
            - 1"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

