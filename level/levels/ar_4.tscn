[sub_resource type="CircleShape2D" id="Circle_1"]
radius = 12.0

[node name="AR4EveryStopAgain" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - leg
        - route
      children:
        - block: MoveTilesBlock
          kind: statement
          text: \"move forward {}\"
          parameters:
            - leg
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - left"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

[node name="LevelDescription" parent="." index="0"]
title = "Every stop, again"
mission = "Last level's rooms. Drive every stop on the card in order, turning left after each one, pick up the pens, and finish on the flag."
rooms = PackedStringArray("A lap that ends where it starts.", "A spiral.", "A U-turn.")
twist = "But there's no item of or length of this time."
blocks = Array[ExtResource("3_block_data")]([ExtResource("17_for_each")])
block_notes = PackedStringArray("Here it hands you each stop on the card, one at a time. A for each loop runs the blocks inside it once for every item, with its variable holding that item.")
tip = "Python has the same loop: for leg in route: runs once for every item in route."

[node name="GenericBlockProvider" parent="." index="2"]
block_data = Array[ExtResource("3_block_data")]([ExtResource("17_for_each")])

