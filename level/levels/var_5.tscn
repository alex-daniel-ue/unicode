[node name="VAR5Swap" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - a
        - \"input ( )\"  # not a readable value
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - b
        - \"input ( )\"  # not a readable value
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - temp
        - a
    - block: SetBlock
      kind: statement
      text: \"set {} to {}\"
      parameters:
        - a
        - b
    - block: SetBlock
      kind: statement
      text: \"set {} to {}\"
      parameters:
        - b
        - temp
    - block: PrintBlock
      kind: statement
      text: \"print {}\"
      parameters:
        - a
    - block: PrintBlock
      kind: statement
      text: \"print {}\"
      parameters:
        - b"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]
star_par_override = 3

