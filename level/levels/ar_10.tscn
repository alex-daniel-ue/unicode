[node name="AR10InBoth" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - s
        - chess
      children:
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: InBlock
              kind: expression
              text: \"{} in {}\"
              parameters:
                - s
                - choir
          children:
            - block: AppendBlock
              kind: statement
              text: \"append {} to {}\"
              parameters:
                - s
                - both"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

[node name="LevelDescription" parent="." index="0"]
title = "In both"
mission = "Find every student who is in both chess and choir. Put each of them into the both list."
rooms = PackedStringArray("Four students in chess.", "Two students in chess.", "Three students in chess.")
twist = "Some rooms have no one in both."
blocks = Array[ExtResource("4_block_data")]([ExtResource("10_contains")])
block_notes = PackedStringArray("This block is True when the value is somewhere in the list.")
block_values = PackedStringArray("2,list:choir")
tip = "In Python: `s in choir`"

