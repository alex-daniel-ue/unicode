[node name="AR10InAllThree" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - s
        - chess
      children:
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: AndOrBlock
              kind: expression
              text: \"{} {} {}\"
              parameters:
                - block: InBlock
                  kind: expression
                  text: \"{} in {}\"
                  parameters:
                    - s
                    - choir
                - and
                - block: InBlock
                  kind: expression
                  text: \"{} in {}\"
                  parameters:
                    - s
                    - coding
          children:
            - block: AddBlock
              kind: statement
              text: \"add {} to {}\"
              parameters:
                - s
                - all_three
        - block: MoveBlock
          kind: statement
          text: \"move forward\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

[node name="LevelDescription" parent="." index="0"]
title = "In all three"
mission = "One program, three rooms. Walk along chess, and add each player who is also in choir and in coding to all_three. Finish on the flag just past the last chess player."
rooms = PackedStringArray("Four chess players.", "Two chess players.", "Three chess players.")
twist = "But a student counts only if they're in chess, choir and coding."
blocks = Array[ExtResource("3_block_data")]([ExtResource("17_contains"), ExtResource("18_and_or")])
block_notes = PackedStringArray("Here it checks whether a student is in a club. It gives True if the value is anywhere in the list, tuple or set.", "Here it can ask about two clubs at once. and is True only when both sides are; or is True when either one is.")
tip = "Python can find what three sets share in one step: chess & choir & coding."

