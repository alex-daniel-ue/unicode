[node name="LevelDescription" parent="." index="0"]
title = "A receipt"
mission = "The user types two things to buy, each one followed by its price. Print a receipt: a line, each thing with its price, a line again, and the total."
rooms = PackedStringArray("The user types Pen, 15, Book and 120.", "The user types Cap, 50, Bag and 300.")
twist = "The line is printed twice, and so is a thing with its price."
tip = "In Python, a function can print: `def line(): print(\"----------\")`"

