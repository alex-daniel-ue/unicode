[node name="FN9AReceipt" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: Call_line
      kind: statement
      text: \"line ( )\"
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - a
        - \"input ( )\"  # not a readable value
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - pa
        - block: ConvertBlock
          kind: value
          text: \"{} ( {} )\"
          parameters:
            - int
            - \"input ( )\"  # not a readable value
    - block: Call_row
      kind: statement
      text: \"row ( {}, {} )\"
      parameters:
        - a
        - pa
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - b
        - \"input ( )\"  # not a readable value
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - pb
        - block: ConvertBlock
          kind: value
          text: \"{} ( {} )\"
          parameters:
            - int
            - \"input ( )\"  # not a readable value
    - block: Call_row
      kind: statement
      text: \"row ( {}, {} )\"
      parameters:
        - b
        - pb
    - block: Call_line
      kind: statement
      text: \"line ( )\"
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - total
        - block: ArithmeticBlock
          kind: value
          text: \"{} {} {}\"
          parameters:
            - pa
            - +
            - pb
    - block: PrintBlock
      kind: statement
      text: \"print {}\"
      parameters:
        - \"Total: {total}\"
functions:  # define blocks: their blocks run when a call to them runs
    - block: Define_line
      kind: nested
      text: \"define line (  )\"
      locked: true
      children:
        - block: PrintBlock
          kind: statement
          text: \"print {}\"
          parameters:
            - \"----------\"
    - block: Define_row
      kind: nested
      text: \"define row ( item, price )\"
      locked: true
      children:
        - block: PrintBlock
          kind: statement
          text: \"print {}\"
          parameters:
            - \"{item}: {price}\""
