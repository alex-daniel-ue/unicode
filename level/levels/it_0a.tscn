[node name="IT0aReadItFirst" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_yq22f")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: MoveBlock
      kind: statement
      text: \"move forward\"
      locked: true
    - block: MoveBlock
      kind: statement
      text: \"move forward\"
      locked: true
    - block: IfBlock
      kind: nested
      text: \"if {}\"
      locked: true
      parameters:
        - block: NotBlock
          kind: expression
          text: \"not {}\"
          locked: true
          parameters:
            - block: AheadIsBlock
              kind: expression
              text: \"ahead is {}\"
              locked: true
              parameters:
                - puddle
      children:
        - block: MoveBlock
          kind: statement
          text: \"move forward\"
          locked: true"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]
prediction_required = true

