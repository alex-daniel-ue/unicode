[node name="IT0aReadItFirst" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: MoveBlock
      kind: statement
      text: \"move forward\"
      locked: true
    - block: MoveBlock
      kind: statement
      text: \"move forward\"
      locked: true
    - block: IfBlock
      kind: nested
      text: \"if {}\"
      locked: true
      parameters:
        - block: NotBlock
          kind: expression
          text: \"not {}\"
          parameters:
            - block: AheadIsBlock
              kind: expression
              text: \"ahead is {}\"
              parameters:
                - puddle
      children:
        - block: MoveBlock
          kind: statement
          text: \"move forward\"
          locked: true"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]
auto_run = true

[node name="LevelDescription" parent="." index="0"]
title = "Read it first"
mission = "This program is already written. Watch it run in Room 1, then again in Room 2, and work out why the robot stops in a different place."
rooms = PackedStringArray("Finish on the flag.", "Stop right before the puddle.")
twist = "But it's the same program in both rooms. The only difference is what's in front of the robot."
blocks = Array[ExtResource("12_block_data")]([ExtResource("6_ahead_is"), ExtResource("7_not"), ExtResource("9_if")])
block_notes = PackedStringArray("Here it looks for the puddle. It checks the one tile in front of the robot and gives True or False.", "Flips the answer, so True becomes False and False becomes True. It lets a program ask the opposite question.", "The last step only happens when its condition is True. An if runs the blocks inside it only when its condition is True.")
block_values = PackedStringArray("puddle", "", "")
tip = "It runs by itself when the level opens. Press Play to watch it again."
show_stars = false

