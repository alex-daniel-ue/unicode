[sub_resource type="CircleShape2D" id="Circle_1"]
radius = 12.0

[node name="AR5EveryStopAgain" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - steps
        - route
      children:
        - block: MoveTilesBlock
          kind: statement
          text: \"step forward {} times\"
          parameters:
            - steps
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - left"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

[node name="LevelDescription" parent="." index="0"]
title = "Every stop, again"
mission = "These are the same rooms as in the last level. Each value in the list is how far to move before the next left turn. Collect every battery on the way to the green flag."
rooms = PackedStringArray("A lap.", "A U-turn.")
twist = "This time, there is no Index Of block and no Length Of block."
blocks = Array[ExtResource("4_block_data")]([ExtResource("18_for_each")])
block_notes = PackedStringArray("This block runs its blocks once for each value in a list. The box that it is on lights up.")
block_values = PackedStringArray("steps,list:route")
tip = "In Python: `for steps in route:`"

[node name="GenericBlockProvider" parent="." index="2"]
block_data = Array[ExtResource("4_block_data")]([ExtResource("18_for_each")])

