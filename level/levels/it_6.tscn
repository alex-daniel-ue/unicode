[node name="IT6APatternNotAStep" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForBlock (Integer)
      kind: nested
      text: \"for var {}, from {}\\nto {}, at step {}\"
      locked: true
      parameters:
        - i
        - 1
        - 4
        - 1
      children:
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - left
        - block: MoveBlock
          kind: statement
          text: \"move forward\"
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - right
        - block: MoveBlock
          kind: statement
          text: \"move forward\""
room_goals = [NodePath("RoomGoals/GoalManager")]

[node name="Header" type="Label" parent="LevelDescription" index="0"]
visible = false
theme_type_variation = &"HeaderMedium"
text = "A pattern, not a step"
horizontal_alignment = 1

[node name="Line1" type="Label" parent="LevelDescription" index="1"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "A staircase. Up one, across one, up one, across one."
autowrap_mode = 3

[node name="Line2" type="Label" parent="LevelDescription" index="2"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "The body of a loop doesn't have to be a single step. It can be a whole little routine, as long as the routine is the same every time."
autowrap_mode = 3

[node name="Line3" type="Label" parent="LevelDescription" index="3"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "The for block is placed and locked. Its step is already 1; you fill in the name and the two bounds."
autowrap_mode = 3

[node name="Line4" type="Label" parent="LevelDescription" index="4"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "Work out one climb first, then ask how many climbs the staircase needs."
autowrap_mode = 3

[node name="Line5" type="Label" parent="LevelDescription" index="5"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "Order matters: from facing right, turn left points the robot UP the stair. The other way around walks it off the bottom."
autowrap_mode = 3

[node name="Line6" type="Label" parent="LevelDescription" index="6"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "3 stars: 4 blocks."
autowrap_mode = 3

