[node name="IT6APatternNotAStep" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForBlock (Integer)
      kind: nested
      text: \"for var {}, from {}\\nto {}, at step {}\"
      locked: true
      parameters:
        - i
        - 1
        - 4
        - 1
      children:
        - block: MoveBlock
          kind: statement
          text: \"move forward\"
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - left
        - block: MoveBlock
          kind: statement
          text: \"move forward\"
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - right"
room_goals = [NodePath("RoomGoals/GoalManager")]

