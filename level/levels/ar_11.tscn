[node name="AR11HereEitherDay" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - s
        - monday
      children:
        - block: AppendBlock
          kind: statement
          text: \"append {} to {}\"
          parameters:
            - s
            - present
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - s
        - tuesday
      children:
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: NotBlock
              kind: expression
              text: \"not {}\"
              parameters:
                - block: InBlock
                  kind: expression
                  text: \"{} in {}\"
                  parameters:
                    - s
                    - present
          children:
            - block: AppendBlock
              kind: statement
              text: \"append {} to {}\"
              parameters:
                - s
                - present"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

[node name="LevelDescription" parent="." index="0"]
title = "Here either day"
mission = "The monday list has the students who came on Monday. The tuesday list has the students who came on Tuesday. Put every student who came on either day into the present list, and put each student in only once."
rooms = PackedStringArray("Three on Monday, three on Tuesday.", "Two on Monday, two on Tuesday.", "Four on Monday, two on Tuesday.")
twist = "Some students came on both days."
tip = "The Not block turns True into False, and False into True."

[node name="GenericBlockProvider" parent="." index="2"]
block_data = Array[ExtResource("4_block_data")]([ExtResource("10_for_each"), ExtResource("11_if"), ExtResource("12_contains"), ExtResource("13_not"), ExtResource("14_append")])

