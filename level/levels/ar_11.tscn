[node name="AR11HereEitherDay" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - s
        - mon
      children:
        - block: AppendBlock
          kind: statement
          text: \"append {} to {}\"
          parameters:
            - s
            - present
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - s
        - tue
      children:
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: NotBlock
              kind: expression
              text: \"not {}\"
              parameters:
                - block: InBlock
                  kind: expression
                  text: \"{} in {}\"
                  parameters:
                    - s
                    - present
          children:
            - block: AppendBlock
              kind: statement
              text: \"append {} to {}\"
              parameters:
                - s
                - present"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

