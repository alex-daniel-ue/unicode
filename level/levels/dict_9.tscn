[node name="DICT9TheBill" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - total
        - 0
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - item
        - cart
      children:
        - block: UpdateBlock
          kind: statement
          text: \"{} {} {}\"
          parameters:
            - total
            - +=
            - block: ArithmeticBlock
              kind: value
              text: \"{} {} {}\"
              parameters:
                - block: DictGetBlock
                  kind: value
                  text: \"{} [ {} ]\"
                  parameters:
                    - prices
                    - item
                - *
                - block: DictGetBlock
                  kind: value
                  text: \"{} [ {} ]\"
                  parameters:
                    - cart
                    - item
    - block: PrintBlock
      kind: statement
      text: \"print {}\"
      parameters:
        - \"Total: {total}\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

