[node name="DICT6CountTheVotes" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForBlock (Integer)
      kind: nested
      text: \"for {}, from {}\\nuntil {}, at step {}\"
      parameters:
        - i
        - 0
        - 3
        - 1
      children:
        - block: DeclareAsBlock
          kind: statement
          text: \"declare {} as {}\"
          parameters:
            - color
            - \"input ( )\"  # not a readable value
        - block: DictSetBlock
          kind: statement
          text: \"set {} [ {} ] to {}\"
          parameters:
            - votes
            - color
            - block: ArithmeticBlock
              kind: value
              text: \"{} {} {}\"
              parameters:
                - block: DictGetBlock
                  kind: value
                  text: \"{} [ {} ]\"
                  parameters:
                    - votes
                    - color
                - +
                - 1"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

