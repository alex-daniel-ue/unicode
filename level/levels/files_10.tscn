[node name="FILES10TheGuestBook" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - name
        - \"input ( )\"  # not a readable value
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - found
        - False
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - line
        - \"guests.txt\"  # not a readable value
      children:
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: ComparisonBlock
              kind: expression
              text: \"{} {} {}\"
              parameters:
                - line
                - ==
                - name
          children:
            - block: SetBlock
              kind: statement
              text: \"set {} to {}\"
              parameters:
                - found
                - True
    - block: IfBlock
      kind: nested
      text: \"if {}\"
      parameters:
        - block: ComparisonBlock
          kind: expression
          text: \"{} {} {}\"
          parameters:
            - found
            - ==
            - True
      children:
        - block: PrintBlock
          kind: statement
          text: \"print {}\"
          parameters:
            - \"Welcome back, {name}!\"
    - block: ElseBlock
      kind: nested
      text: \"else\"
      children:
        - block: WriteBlock
          kind: statement
          text: \"write {} to {}\"
          parameters:
            - name
            - \"guests.txt\"  # not a readable value
        - block: PrintBlock
          kind: statement
          text: \"print {}\"
          parameters:
            - \"Welcome, {name}!\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

[node name="LevelDescription" parent="." index="0"]
title = "The guest book"
mission = "guests.txt has the names of everyone who came before. The user types a name. When the name is already in the file, show Welcome back, and the name. When it isn't, write it in the file and show Welcome, and the name."
rooms = PackedStringArray("The user types Ben.", "The user types Zoe.")
twist = "One user came before, and one is new."
tip = "A variable like `found = False` can remember what a loop saw. Compare it with True afterwards."

