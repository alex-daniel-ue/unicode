[node name="SelRunnerThreeRooms" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "block: BeginBlock
  text: \"begin code\"
  children:
    - block: WhileBlock
      text: \"while {}\"
      parameters:
        - block: NotBlock
          text: \"not {}\"
          parameters:
            - block: AheadIsBlock
              text: \"ahead is {}\"
              parameters:
                - \"door\"
      children:
        - block: MoveBlock
          text: \"move forward\"
    - block: MoveBlock
      text: \"move forward\"
"
