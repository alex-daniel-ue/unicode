[node name="IT1UntilTheWall" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: WhileBlock
      kind: nested
      text: \"while {}\"
      locked: true
      parameters:
        - block: NotBlock
          kind: expression
          text: \"not {}\"
          parameters:
            - block: AheadIsBlock
              kind: expression
              text: \"ahead is {}\"
              parameters:
                - blocked
      children:
        - block: MoveBlock
          kind: statement
          text: \"move forward\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

