[node name="FN10Spiral" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForBlock (Integer)
      kind: nested
      text: \"for {}, from {}\\nuntil {}, at step {}\"
      parameters:
        - i
        - 1
        - block: ArithmeticBlock
          kind: value
          text: \"{} {} {}\"
          parameters:
            - block: ConvertBlock
              kind: value
              text: \"{} ( {} )\"
              parameters:
                - int
                - \"input ( )\"  # not a readable value
            - +
            - 1
        - 1
      children:
        - block: Call_side
          kind: statement
          text: \"side ( {} )\"
          parameters:
            - i
functions:  # define blocks: their blocks run when a call to them runs
    - block: Define_side
      kind: nested
      text: \"define side ( n )\"
      locked: true
      children:
        - block: MoveTilesBlock
          kind: statement
          text: \"step forward {} times\"
          parameters:
            - n
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - left"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

[node name="LevelDescription" parent="." index="0"]
title = "Spiral"
mission = "The user types how many sides the spiral has. Walk the spiral to the green flag: the first side is 1 tile long, and each side after it is 1 tile longer."
rooms = PackedStringArray("The user types 4.", "The user types 5.")
twist = "The rooms have spirals of different sizes."
tip = "In Python, `range(1, n + 1)` counts from 1 up to n."

