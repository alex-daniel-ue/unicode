[node name="AR7PassingMarks" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - s
        - scores
      children:
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: ComparisonBlock
              kind: expression
              text: \"{} {} {}\"
              parameters:
                - s
                - >=
                - 75
          children:
            - block: AppendBlock
              kind: statement
              text: \"append {} to {}\"
              parameters:
                - s
                - passed
    - block: MoveTilesBlock
      kind: statement
      text: \"move forward {}\"
      parameters:
        - block: LengthOfBlock
          kind: value
          text: \"length of {}\"
          parameters:
            - passed"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

[node name="LevelDescription" parent="." index="0"]
title = "Passing marks"
mission = "One program, three rooms. Put every passing score (75 or higher) from scores into passed, then walk one tile for each passing score to reach the flag."
rooms = PackedStringArray("Five scores.", "Four scores.", "Six scores.")
twist = "But scores is a tuple, and a tuple can't be changed."
blocks = Array[ExtResource("3_block_data")]([ExtResource("17_append")])
block_notes = PackedStringArray("Here it adds a passing score to the end of passed. It makes a list one item longer; a tuple can't grow.")
tip = "The brackets on a shelf say what it holds, the way Python writes it: [ ] is a list and ( ) is a tuple."

