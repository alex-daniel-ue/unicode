[node name="AR7NumberTheLockers" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForBlock (Integer)
      kind: nested
      text: \"for {}, from {}\\nuntil {}, at step {}\"
      parameters:
        - i
        - 0
        - block: LengthOfBlock
          kind: value
          text: \"length of {}\"
          parameters:
            - lockers
        - 1
      children:
        - block: SetItemBlock
          kind: statement
          text: \"set item {} of {} to {}\"
          parameters:
            - i
            - lockers
            - block: ArithmeticBlock
              kind: value
              text: \"{} {} {}\"
              parameters:
                - i
                - +
                - 1"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

