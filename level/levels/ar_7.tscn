[node name="AR7PassingMarks" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - s
        - scores
      children:
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: ComparisonBlock
              kind: expression
              text: \"{} {} {}\"
              parameters:
                - s
                - >=
                - 75
          children:
            - block: AppendBlock
              kind: statement
              text: \"append {} to {}\"
              parameters:
                - s
                - passed
        - block: MoveBlock
          kind: statement
          text: \"move forward\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

[node name="LevelDescription" parent="." index="0"]
title = "Passing marks"
mission = "One program, three rooms. Walk along scores, and copy each pass (75 or higher) into passed as you go, so passed fills up like its faded bags. Finish on the flag just past the last score."
rooms = PackedStringArray("Five scores.", "Four scores.", "Six scores.")
twist = "But scores is a tuple, and a tuple can't be changed."
idea_title = "Tuple"
idea = "A tuple is a list that can't be changed once it's made. Python writes one with round brackets: scores = (70, 82, 75). You can read its items, count them and loop over them, but you can't set an item or append to it. That keeps things like recorded scores safe; to get a changed version, you build a new list from it."
blocks = Array[ExtResource("3_block_data")]([ExtResource("17_append")])
block_notes = PackedStringArray("Here it copies a pass onto the end of passed. It makes a list one item longer; a tuple can't grow.")
tip = "The brackets on a shelf say what it holds, the way Python writes it: [ ] is a list and ( ) is a tuple. In Python, append s to passed is written passed.append(s)."

[node name="GenericBlockProvider" parent="." index="2"]
