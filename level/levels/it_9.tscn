[node name="IT9TwoWaysOut" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: WhileBlock
      kind: nested
      text: \"while {}\"
      parameters:
        - block: BooleanBlock
          kind: expression
          text: \"{}\"
          parameters:
            - True
      children:
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: AheadIsBlock
              kind: expression
              text: \"ahead is {}\"
              parameters:
                - puddle
          children:
            - block: BreakBlock
              kind: statement
              text: \"break\"
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: AheadIsBlock
              kind: expression
              text: \"ahead is {}\"
              parameters:
                - destination
          children:
            - block: MoveBlock
              kind: statement
              text: \"move forward\"
            - block: BreakBlock
              kind: statement
              text: \"break\"
        - block: MoveBlock
          kind: statement
          text: \"move forward\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

