[node name="IT3AroundTheBends" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: WhileBlock
      kind: nested
      text: \"while {}\"
      parameters:
        - block: NotBlock
          kind: expression
          text: \"not {}\"
          parameters:
            - block: AheadIsBlock
              kind: expression
              text: \"ahead is {}\"
              parameters:
                - destination
      children:
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: AheadIsBlock
              kind: expression
              text: \"ahead is {}\"
              parameters:
                - blocked
          children:
            - block: TurnBlock
              kind: statement
              text: \"turn {}\"
              parameters:
                - left
        - block: ElseBlock
          kind: nested
          text: \"else\"
          children:
            - block: MoveBlock
              kind: statement
              text: \"move forward\"
    - block: MoveBlock
      kind: statement
      text: \"move forward\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

[node name="LevelDescription" parent="." index="0"]
title = "Around the bends"
mission = "One program, three rooms with corners. Finish on the flag in every room."
rooms = PackedStringArray("One bend.", "Two bends.", "A winding path.")
twist = "But every room turns a different number of times, so no fixed list of moves works for all three."
blocks = Array[ExtResource("11_block_data")]([ExtResource("4_if"), ExtResource("5_else"), ExtResource("24_turn")])
block_notes = PackedStringArray("Lets the robot make a decision at every step. It runs the blocks inside it only when its condition is True.", "Goes right under an if and runs only when that if didn't. Together they make an either-or choice.", "Turns the robot left, right, or back (all the way around). Turning doesn't move it off its tile.")

