[node name="IT3AroundTheBends" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: WhileBlock
      kind: nested
      text: \"while {}\"
      parameters:
        - block: NotBlock
          kind: expression
          text: \"not {}\"
          parameters:
            - block: AheadIsBlock
              kind: expression
              text: \"ahead is {}\"
              parameters:
                - destination
      children:
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: AheadIsBlock
              kind: expression
              text: \"ahead is {}\"
              parameters:
                - blocked
          children:
            - block: TurnBlock
              kind: statement
              text: \"turn {}\"
              parameters:
                - left
        - block: ElseBlock
          kind: nested
          text: \"else\"
          children:
            - block: MoveBlock
              kind: statement
              text: \"move forward\"
    - block: MoveBlock
      kind: statement
      text: \"move forward\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]
star_slack = 2

[node name="Header" type="Label" parent="LevelDescription" index="0"]
visible = false
theme_type_variation = &"HeaderMedium"
text = "Around the bends"
horizontal_alignment = 1

[node name="Line1" type="Label" parent="LevelDescription" index="1"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "One bend, two bends, then a lot of them. Hardcoding the number of turns dies in Room 2."
autowrap_mode = 3

[node name="Line2" type="Label" parent="LevelDescription" index="2"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "Every pass of the loop, the robot has one decision to make: is the way ahead blocked?"
autowrap_mode = 3

[node name="Inert3" parent="LevelDescription" index="3" instance=ExtResource("3_nested")]
visible = false
offset_right = 140.0
data = ExtResource("4_if")

[node name="Inert4" parent="LevelDescription" index="4" instance=ExtResource("3_nested")]
visible = false
offset_right = 140.0
data = ExtResource("5_else")

[node name="Line5" type="Label" parent="LevelDescription" index="5"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "If it's blocked, turn. Otherwise, step. Not both in the same pass -- Room 3 starts in a corner that needs three turns before a single step is possible."
autowrap_mode = 3

[node name="Line6" type="Label" parent="LevelDescription" index="6"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "Every corner in this level turns LEFT. Pick right and the robot paces the corridor forever without ever hitting anything. That's a real answer to a real mistake, and the Stop button ends it -- the game hasn't frozen."
autowrap_mode = 3

[node name="Line7" type="Label" parent="LevelDescription" index="7"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "You can also write this with a loop inside a loop, or with while True and a break. Both are accepted. Either way the loop ends with the door in front of the robot, so it still needs one last step."
autowrap_mode = 3

[node name="Line8" type="Label" parent="LevelDescription" index="8"]
visible = false
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "3 stars: 6 blocks."
autowrap_mode = 3

