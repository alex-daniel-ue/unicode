[node name="IT4CountTheDesks" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare var {} as {}\"
      parameters:
        - i
        - 0
    - block: WhileBlock
      kind: nested
      text: \"while {}\"
      parameters:
        - block: ComparisonBlock
          kind: expression
          text: \"{} {} {}\"
          parameters:
            - i
            - <
            - 3
      children:
        - block: MoveBlock
          kind: statement
          text: \"move forward\"
          locked: true
        - block: IncrementBlock
          kind: statement
          text: \"increment {}\"
          parameters:
            - i"
room_goals = [NodePath("RoomGoals/GoalManager")]

