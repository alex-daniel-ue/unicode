[node name="FN6HowFarApart" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: MoveTilesBlock
      kind: statement
      text: \"step forward {} times\"
      parameters:
        - block: Call_distance
          kind: value
          text: \"distance ( {}, {} )\"
          parameters:
            - block: ConvertBlock
              kind: value
              text: \"{} ( {} )\"
              parameters:
                - int
                - \"input ( )\"  # not a readable value
            - block: ConvertBlock
              kind: value
              text: \"{} ( {} )\"
              parameters:
                - int
                - \"input ( )\"  # not a readable value
functions:  # define blocks: their blocks run when a call to them runs
    - block: Define_distance
      kind: nested
      text: \"define distance ( a, b )\"
      locked: true
      children:
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: ComparisonBlock
              kind: expression
              text: \"{} {} {}\"
              parameters:
                - a
                - >
                - b
          children:
            - block: ReturnBlock
              kind: statement
              text: \"return {}\"
              parameters:
                - block: ArithmeticBlock
                  kind: value
                  text: \"{} {} {}\"
                  parameters:
                    - a
                    - -
                    - b
        - block: ElseBlock
          kind: nested
          text: \"else\"
          children:
            - block: ReturnBlock
              kind: statement
              text: \"return {}\"
              parameters:
                - block: ArithmeticBlock
                  kind: value
                  text: \"{} {} {}\"
                  parameters:
                    - b
                    - -
                    - a"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

[node name="LevelDescription" parent="." index="0"]
title = "How far apart"
mission = "The user types two numbers. The green flag is as many tiles away as the difference between them. Make distance give back that difference. It is never less than 0."
rooms = PackedStringArray("The user types 2 and 6.", "The user types 7 and 2.", "The user types 3 and 4.")
twist = "Sometimes the first number is bigger, and sometimes the second one is."
tip = "Python has this function built in: `abs(a - b)`."

[node name="GenericBlockProvider" parent="." index="2"]
