[sub_resource type="CircleShape2D" id="Circle_1"]
radius = 12.0

[node name="FN3HandItANumber" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: Call_side
      kind: statement
      text: \"side ( {} )\"
      parameters:
        - 4
    - block: Call_side
      kind: statement
      text: \"side ( {} )\"
      parameters:
        - 2
    - block: Call_side
      kind: statement
      text: \"side ( {} )\"
      parameters:
        - 4
    - block: Call_side
      kind: statement
      text: \"side ( {} )\"
      parameters:
        - 2
functions:  # define blocks: their blocks run when a call to them runs
    - block: Define_side
      kind: nested
      text: \"define side ( n )\"
      locked: true
      children:
        - block: MoveTilesBlock
          kind: statement
          text: \"step forward {} times\"
          locked: true
          parameters:
            - n
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          locked: true
          parameters:
            - left"
room_goals = [NodePath("RoomGoals/GoalManager")]

[node name="LevelDescription" parent="." index="0"]
title = "Hand it a number"
mission = "Take the robot all the way round the room, back to the green flag, and collect every battery."
twist = "The long sides and the short sides are not the same length."
tip = "In Python, `def side(n):` makes a function with a parameter n. `side(4)` runs it with n as 4."

[node name="GenericBlockProvider" parent="." index="2"]
block_data = Array[ExtResource("4_block_data")]([])

[node name="Functions" type="Node" parent="."]
