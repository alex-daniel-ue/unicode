[node name="FILES4CopyAFile" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - line
        - \"poem.txt\"  # not a readable value
      children:
        - block: WriteBlock
          kind: statement
          text: \"write {} to {}\"
          parameters:
            - line
            - \"copy.txt\"  # not a readable value"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

