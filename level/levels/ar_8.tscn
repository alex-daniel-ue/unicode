[node name="AR8TidyTheShelf" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: AppendBlock
      kind: statement
      text: \"append {} to {}\"
      parameters:
        - block: ItemOfBlock
          kind: value
          text: \"item {} of {}\"
          parameters:
            - 0
            - bags
        - tidy
    - block: ForBlock (Integer)
      kind: nested
      text: \"for var {}, from {}\\nto {}, at step {}\"
      parameters:
        - i
        - 1
        - block: ArithmeticBlock
          kind: value
          text: \"{} {} {}\"
          parameters:
            - block: LengthOfBlock
              kind: value
              text: \"length of {}\"
              parameters:
                - bags
            - -
            - 1
        - 1
      children:
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: ComparisonBlock
              kind: expression
              text: \"{} {} {}\"
              parameters:
                - block: ItemOfBlock
                  kind: value
                  text: \"item {} of {}\"
                  parameters:
                    - i
                    - bags
                - !=
                - block: ItemOfBlock
                  kind: value
                  text: \"item {} of {}\"
                  parameters:
                    - block: ArithmeticBlock
                      kind: value
                      text: \"{} {} {}\"
                      parameters:
                        - i
                        - -
                        - 1
                    - bags
          children:
            - block: AppendBlock
              kind: statement
              text: \"append {} to {}\"
              parameters:
                - block: ItemOfBlock
                  kind: value
                  text: \"item {} of {}\"
                  parameters:
                    - i
                    - bags
                - tidy
    - block: MoveTilesBlock
      kind: statement
      text: \"move forward {}\"
      parameters:
        - block: LengthOfBlock
          kind: value
          text: \"length of {}\"
          parameters:
            - tidy"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

[node name="LevelDescription" parent="." index="0"]
title = "Tidy the shelf"
mission = "One program, three rooms. Copy bags onto tidy, leaving out any bag that's the same as the one right before it. Then walk one tile for each bag on tidy."
rooms = PackedStringArray("Eight bags.", "Five bags.", "Four bags.")
twist = "But a number can come back later, and when it does, it stays."
tip = "!= means not equal. It's in the comparison block's list."

