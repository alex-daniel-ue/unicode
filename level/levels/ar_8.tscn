[node name="AR8PassingMarks" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - s
        - scores
      children:
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: ComparisonBlock
              kind: expression
              text: \"{} {} {}\"
              parameters:
                - s
                - >=
                - 75
          children:
            - block: AppendBlock
              kind: statement
              text: \"append {} to {}\"
              parameters:
                - s
                - passed"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

