[node name="FILES8PassingScores" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - line
        - \"scores.txt\"  # not a readable value
      children:
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: ComparisonBlock
              kind: expression
              text: \"{} {} {}\"
              parameters:
                - block: ConvertBlock
                  kind: value
                  text: \"{} ( {} )\"
                  parameters:
                    - int
                    - line
                - >=
                - 75
          children:
            - block: WriteBlock
              kind: statement
              text: \"write {} to {}\"
              parameters:
                - line
                - \"passed.txt\"  # not a readable value"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

[node name="LevelDescription" parent="." index="0"]
title = "Passing scores"
mission = "Copy only the passing scores, 75 and up, from scores.txt into passed.txt, in order."
rooms = PackedStringArray("Four scores.", "Three scores.")
tip = "In Python, compare numbers, not text: `int(line) >= 75`."

