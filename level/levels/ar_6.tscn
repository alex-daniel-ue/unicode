[node name="AR6ThereAndBack" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - steps
        - route
      children:
        - block: MoveTilesBlock
          kind: statement
          text: \"step forward {} times\"
          parameters:
            - steps
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - left
    - block: TurnBlock
      kind: statement
      text: \"turn {}\"
      parameters:
        - around
    - block: ForBlock (Integer)
      kind: nested
      text: \"for {}, from {}\\nuntil {}, at step {}\"
      parameters:
        - i
        - block: ArithmeticBlock
          kind: value
          text: \"{} {} {}\"
          parameters:
            - block: LengthOfBlock
              kind: value
              text: \"length of {}\"
              parameters:
                - route
            - -
            - 1
        - -1
        - -1
      children:
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - right
        - block: MoveTilesBlock
          kind: statement
          text: \"step forward {} times\"
          parameters:
            - block: ItemOfBlock
              kind: value
              text: \"index {} of {}\"
              parameters:
                - i
                - route"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]
star_slack = 2

[node name="LevelDescription" parent="." index="0"]
title = "There and back"
mission = "Move out and collect every battery. Then move back the same way, to the green flag where you started."
rooms = PackedStringArray("A long way out.", "A winding way out.")
twist = "The way back is the list, read backwards."
tip = "The For block can count down. Give it a step of -1."

