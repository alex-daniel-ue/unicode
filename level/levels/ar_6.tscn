[node name="AR6NumberTheLockers" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForBlock (Integer)
      kind: nested
      text: \"for var {}, from {}\\nto {}, at step {}\"
      parameters:
        - i
        - 0
        - block: ArithmeticBlock
          kind: value
          text: \"{} {} {}\"
          parameters:
            - block: LengthOfBlock
              kind: value
              text: \"length of {}\"
              parameters:
                - lockers
            - -
            - 1
        - 1
      children:
        - block: SetItemBlock
          kind: statement
          text: \"set item {} of {} to {}\"
          parameters:
            - i
            - lockers
            - block: ArithmeticBlock
              kind: value
              text: \"{} {} {}\"
              parameters:
                - i
                - +
                - 1
        - block: MoveTilesBlock
          kind: statement
          text: \"move forward {}\"
          parameters:
            - 1"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

[node name="LevelDescription" parent="." index="0"]
title = "Number the lockers"
mission = "One program, three rooms. Walk along the lockers and give each one its number, then finish on the flag just past the last locker."
rooms = PackedStringArray("Three lockers.", "Five lockers.", "Four lockers.")
twist = "But locker numbers are for people, and people count from 1."
blocks = Array[ExtResource("3_block_data")]([ExtResource("17_set_item")])
block_notes = PackedStringArray("Here it writes a number onto a locker. It changes the item at a position in a list, and that position has to exist already.")
tip = "In Python, set item 0 of lockers to 5 is written lockers[0] = 5."

