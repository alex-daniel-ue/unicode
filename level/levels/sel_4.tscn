[node name="SEL4ThreeBins" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - item
        - \"input ( )\"  # not a readable value
    - block: MoveTilesBlock
      kind: statement
      text: \"step forward {} times\"
      parameters:
        - 2
    - block: IfBlock
      kind: nested
      text: \"if {}\"
      parameters:
        - block: ComparisonBlock
          kind: expression
          text: \"{} {} {}\"
          parameters:
            - item
            - ==
            - \"paper\"
      children:
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - left
        - block: MoveBlock
          kind: statement
          text: \"step forward\"
    - block: ElifBlock
      kind: nested
      text: \"elif {}\"
      parameters:
        - block: ComparisonBlock
          kind: expression
          text: \"{} {} {}\"
          parameters:
            - item
            - ==
            - \"can\"
      children:
        - block: MoveTilesBlock
          kind: statement
          text: \"step forward {} times\"
          parameters:
            - 2
    - block: ElseBlock
      kind: nested
      text: \"else\"
      children:
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - right
        - block: MoveBlock
          kind: statement
          text: \"step forward\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

[node name="LevelDescription" parent="." index="0"]
title = "Three bins"
mission = "The user types what is in the robot's hand: paper, can or plastic. Take it to the bin with that name. The green flag shows the right bin in each room."
rooms = PackedStringArray("The user types paper.", "The user types can.", "The user types plastic.")
twist = "There are three ways to go, not two."
blocks = Array[ExtResource("4_block_data")]([ExtResource("18_elif")])
block_notes = PackedStringArray("Put this block under an If block. It checks its own condition only when the blocks above it did not run.")
tip = "In Python: `elif item == \"can\":`"

