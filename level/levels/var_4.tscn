block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - first
        - \"input ( )\"  # not a readable value
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - second
        - \"input ( )\"  # not a readable value
    - block: PrintBlock
      kind: statement
      text: \"print {}\"
      parameters:
        - \"{first} {second} {first}\""
