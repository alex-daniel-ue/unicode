[node name="DICT7NewWords" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForBlock (Integer)
      kind: nested
      text: \"for {}, from {}\\nuntil {}, at step {}\"
      parameters:
        - i
        - 0
        - 4
        - 1
      children:
        - block: DeclareAsBlock
          kind: statement
          text: \"declare {} as {}\"
          parameters:
            - word
            - \"input ( )\"  # not a readable value
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: InBlock
              kind: expression
              text: \"{} in {}\"
              parameters:
                - word
                - counts
          children:
            - block: DictSetBlock
              kind: statement
              text: \"set {} [ {} ] to {}\"
              parameters:
                - counts
                - word
                - block: ArithmeticBlock
                  kind: value
                  text: \"{} {} {}\"
                  parameters:
                    - block: DictGetBlock
                      kind: value
                      text: \"{} [ {} ]\"
                      parameters:
                        - counts
                        - word
                    - +
                    - 1
        - block: ElseBlock
          kind: nested
          text: \"else\"
          children:
            - block: DictSetBlock
              kind: statement
              text: \"set {} [ {} ] to {}\"
              parameters:
                - counts
                - word
                - 1"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

[node name="LevelDescription" parent="." index="0"]
title = "New words"
mission = "The user types four words. Count how many times each word comes, in the counts dictionary."
rooms = PackedStringArray("The user types hi, yes, hi and hi.", "The user types go, stop, wait and go.")
twist = "The dictionary starts empty, so a word's first time is not like the times after it."
tip = "In Python: `if word in counts:` tells a word that came before from a new one."

