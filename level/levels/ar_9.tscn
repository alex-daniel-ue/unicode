[node name="AR9HereEitherDay" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - s
        - mon
      children:
        - block: AddBlock
          kind: statement
          text: \"add {} to {}\"
          parameters:
            - s
            - present
        - block: MoveBlock
          kind: statement
          text: \"move forward\"
    - block: MoveBlock
      kind: statement
      text: \"move forward\"
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - s
        - tue
      children:
        - block: AddBlock
          kind: statement
          text: \"add {} to {}\"
          parameters:
            - s
            - present
        - block: MoveBlock
          kind: statement
          text: \"move forward\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

[node name="LevelDescription" parent="." index="0"]
title = "Here either day"
mission = "One program, three rooms. Walk along mon, step across the gap, then walk along tue, adding every student you pass to present. Finish on the flag just past tue."
rooms = PackedStringArray("Three and three.", "Two and two.", "Four and two.")
twist = "But some students came on both days."
idea_title = "Set"
idea = "A set holds values with no repeats. Python writes one with curly brackets: {1, 2, 3}. Adding a value that's already in it changes nothing, so a set is how you keep one of each. A set's items have no positions, so there's no item 0; the shelf shows them in order only to be easy to read."
blocks = Array[ExtResource("3_block_data")]([ExtResource("17_add")])
block_notes = PackedStringArray("Here it puts a student into present. It adds a value to a set, unless the set already has it.")
tip = "In Python, add s to present is written present.add(s)."

