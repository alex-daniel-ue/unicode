[node name="AR9HereEitherDay" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - s
        - mon
      children:
        - block: AddBlock
          kind: statement
          text: \"add {} to {}\"
          parameters:
            - s
            - present
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - s
        - tue
      children:
        - block: AddBlock
          kind: statement
          text: \"add {} to {}\"
          parameters:
            - s
            - present
    - block: MoveTilesBlock
      kind: statement
      text: \"move forward {}\"
      parameters:
        - block: LengthOfBlock
          kind: value
          text: \"length of {}\"
          parameters:
            - present"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

[node name="LevelDescription" parent="." index="0"]
title = "Here either day"
mission = "One program, three rooms. Put everyone who came on Monday or Tuesday into present, then walk one tile for each student in it."
rooms = PackedStringArray("Three and three.", "Two and two.", "Four and two.")
twist = "But some students came on both days."
blocks = Array[ExtResource("3_block_data")]([ExtResource("17_add")])
block_notes = PackedStringArray("Here it puts a student into present. It adds a value to a set, and a set keeps only one of each value.")
tip = "Curly brackets mean a set, as in Python: {1, 2, 3}. Python can join two sets in one step with |."

