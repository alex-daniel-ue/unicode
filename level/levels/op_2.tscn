[node name="OP2AddAndSubtract" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - x
        - block: ConvertBlock
          kind: value
          text: \"{} ( {} )\"
          parameters:
            - int
            - \"input ( )\"  # not a readable value
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - y
        - block: ConvertBlock
          kind: value
          text: \"{} ( {} )\"
          parameters:
            - int
            - \"input ( )\"  # not a readable value
    - block: PrintBlock
      kind: statement
      text: \"print {}\"
      parameters:
        - block: ArithmeticBlock
          kind: value
          text: \"{} {} {}\"
          parameters:
            - x
            - +
            - y
    - block: PrintBlock
      kind: statement
      text: \"print {}\"
      parameters:
        - block: ArithmeticBlock
          kind: value
          text: \"{} {} {}\"
          parameters:
            - x
            - -
            - y"
