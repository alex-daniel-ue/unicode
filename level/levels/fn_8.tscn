[node name="FN8EvenOrNot" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForBlock (Integer)
      kind: nested
      text: \"for {}, from {}\\nuntil {}, at step {}\"
      parameters:
        - i
        - 0
        - 3
        - 1
      children:
        - block: DeclareAsBlock
          kind: statement
          text: \"declare {} as {}\"
          parameters:
            - n
            - block: ConvertBlock
              kind: value
              text: \"{} ( {} )\"
              parameters:
                - int
                - \"input ( )\"  # not a readable value
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: Call_is_even
              kind: expression
              text: \"is_even ( {} )\"
              parameters:
                - n
          children:
            - block: PrintBlock
              kind: statement
              text: \"print {}\"
              parameters:
                - \"{n} is even.\"
        - block: ElseBlock
          kind: nested
          text: \"else\"
          children:
            - block: PrintBlock
              kind: statement
              text: \"print {}\"
              parameters:
                - \"{n} is odd.\"
functions:  # define blocks: their blocks run when a call to them runs
    - block: Define_is_even
      kind: nested
      text: \"define is_even ( n )\"
      locked: true
      children:
        - block: ReturnBlock
          kind: statement
          text: \"return {}\"
          parameters:
            - block: ComparisonBlock
              kind: expression
              text: \"{} {} {}\"
              parameters:
                - block: ArithmeticBlock
                  kind: value
                  text: \"{} {} {}\"
                  parameters:
                    - n
                    - %
                    - 2
                - ==
                - 0"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

[node name="LevelDescription" parent="." index="0"]
title = "Even or not"
mission = "The user types three numbers. Show whether each one is even or odd. The function is_even gives back True or False."
rooms = PackedStringArray("The user types 4, 7 and 10.", "The user types 1, 2 and 3.")
tip = "In Python: `return n % 2 == 0`"

