[node name="DICT3NewPrice" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - item
        - \"input ( )\"  # not a readable value
    - block: DictSetBlock
      kind: statement
      text: \"set {} [ {} ] to {}\"
      parameters:
        - prices
        - item
        - block: ConvertBlock
          kind: value
          text: \"{} ( {} )\"
          parameters:
            - int
            - \"input ( )\"  # not a readable value"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

[node name="LevelDescription" parent="." index="0"]
title = "New price"
mission = "The user types a thing in the shop, and then its new price. Change its price in the prices dictionary."
rooms = PackedStringArray("The user types pen and 20.", "The user types bag and 250.")
twist = "The new price comes in as text."
blocks = Array[ExtResource("4_block_data")]([ExtResource("12_dict_set")])
block_notes = PackedStringArray("This block gives a key a value. When the key isn't there yet, it adds it.")
tip = "In Python: `prices[\"pen\"] = 20`"

