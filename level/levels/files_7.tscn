[node name="FILES7WriteTheSquares" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - n
        - block: ConvertBlock
          kind: value
          text: \"{} ( {} )\"
          parameters:
            - int
            - \"input ( )\"  # not a readable value
    - block: ForBlock (Integer)
      kind: nested
      text: \"for {}, from {}\\nuntil {}, at step {}\"
      parameters:
        - i
        - 1
        - block: ArithmeticBlock
          kind: value
          text: \"{} {} {}\"
          parameters:
            - n
            - +
            - 1
        - 1
      children:
        - block: WriteBlock
          kind: statement
          text: \"write {} to {}\"
          parameters:
            - block: ConvertBlock
              kind: value
              text: \"{} ( {} )\"
              parameters:
                - str
                - block: ArithmeticBlock
                  kind: value
                  text: \"{} {} {}\"
                  parameters:
                    - i
                    - *
                    - i
            - \"squares.txt\"  # not a readable value"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

[node name="LevelDescription" parent="." index="0"]
title = "Write the squares"
mission = "The user types a number n. Write the squares of 1 up to n into squares.txt, one on each line: 1, 4, 9, and so on."
rooms = PackedStringArray("The user types 3.", "The user types 5.")
twist = "Write only takes text."
tip = "In Python, `f.write(str(16))` writes 16. `f.write(16)` is an error."

