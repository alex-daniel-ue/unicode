theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "from 1 to 4 runs four times. In C that's for (int i = 1; i <= 4; i++), and in Python it's range(1, 5)."
autowrap_mode = 3

[node name="Line5" type="Label" parent="LevelDescription" index="5"]
