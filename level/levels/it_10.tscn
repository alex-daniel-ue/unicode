[node name="IT10BackToTheQuestion" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: WhileBlock
      kind: nested
      text: \"while {}\"
      parameters:
        - block: NotBlock
          kind: expression
          text: \"not {}\"
          parameters:
            - block: AheadIsBlock
              kind: expression
              text: \"ahead is {}\"
              parameters:
                - destination
      children:
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: AheadIsBlock
              kind: expression
              text: \"ahead is {}\"
              parameters:
                - blocked
          children:
            - block: TurnBlock
              kind: statement
              text: \"turn {}\"
              parameters:
                - left
            - block: ContinueBlock
              kind: statement
              text: \"continue\"
        - block: MoveBlock
          kind: statement
          text: \"move forward\"
    - block: MoveBlock
      kind: statement
      text: \"move forward\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

[node name="LevelDescription" parent="." index="0"]
title = "Back to the question"
mission = "One program, three winding rooms. Finish on the flag in every room."
twist = "But there's no else block this time."
blocks = Array[ExtResource("6_block_data")]([ExtResource("5_continue")])
block_notes = PackedStringArray("Skips the rest of the loop's blocks for this pass and goes straight back to the loop's condition. It's a loop's way of saying: check again.")

