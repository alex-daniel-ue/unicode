[node name="DICT10SoldOut" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - item
        - \"input ( )\"  # not a readable value
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - sold
        - block: ConvertBlock
          kind: value
          text: \"{} ( {} )\"
          parameters:
            - int
            - \"input ( )\"  # not a readable value
    - block: DictSetBlock
      kind: statement
      text: \"set {} [ {} ] to {}\"
      parameters:
        - stock
        - item
        - block: ArithmeticBlock
          kind: value
          text: \"{} {} {}\"
          parameters:
            - block: DictGetBlock
              kind: value
              text: \"{} [ {} ]\"
              parameters:
                - stock
                - item
            - -
            - sold
    - block: IfBlock
      kind: nested
      text: \"if {}\"
      parameters:
        - block: ComparisonBlock
          kind: expression
          text: \"{} {} {}\"
          parameters:
            - block: DictGetBlock
              kind: value
              text: \"{} [ {} ]\"
              parameters:
                - stock
                - item
            - ==
            - 0
      children:
        - block: DictRemoveBlock
          kind: statement
          text: \"remove {} from {}\"
          parameters:
            - item
            - stock"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

[node name="LevelDescription" parent="." index="0"]
title = "Sold out"
mission = "The user types a thing that was sold, and then how many were sold. Take them from the stock. When none are left, remove the thing from the stock dictionary."
rooms = PackedStringArray("The user types pen and 3.", "The user types bag and 2.")
twist = "In one room, the last ones are sold."
blocks = Array[ExtResource("4_block_data")]([ExtResource("12_dict_remove")])
block_notes = PackedStringArray("This block takes a key and its value out of a dictionary.")
tip = "In Python: `del stock[\"pen\"]` removes the key \"pen\"."

