[node name="FILES1ReadEveryLine" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - line
        - \"notes.txt\"  # not a readable value
      children:
        - block: PrintBlock
          kind: statement
          text: \"print {}\"
          parameters:
            - line"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

[node name="LevelDescription" parent="." index="0"]
title = "Read every line"
mission = "Show every line of the file notes.txt on the terminal, in order."
rooms = PackedStringArray("Three lines.", "Two lines.")
twist = "The file has different lines in each room."
blocks = Array[ExtResource("4_block_data")]([ExtResource("12_file_reporte")])
block_notes = PackedStringArray("This is the name block of a file. It is the file, opened. Put it into For Each to read the file's lines.")
tip = "In Python: `for line in open(\"notes.txt\"):`"

[node name="GenericBlockProvider" parent="." index="2"]
