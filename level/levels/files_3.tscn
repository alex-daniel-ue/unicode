[node name="FILES3WriteItDown" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: WriteBlock
      kind: statement
      text: \"write {} to {}\"
      parameters:
        - \"input ( )\"  # not a readable value
        - \"log.txt\"  # not a readable value"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

[node name="LevelDescription" parent="." index="0"]
title = "Write it down"
mission = "The user types a message. Keep it: write it in the file log.txt."
rooms = PackedStringArray("The user types Lunch at noon.", "The user types Room 5 is free.")
twist = "The terminal shows a message only while the program runs. A file keeps it."
blocks = Array[ExtResource("4_block_data")]([ExtResource("12_write")])
block_notes = PackedStringArray("This block adds a line of text to the end of a file.")
tip = "In Python: `f.write(message)`"

