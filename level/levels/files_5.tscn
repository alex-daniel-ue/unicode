[node name="FILES5FindAWord" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - word
        - \"input ( )\"  # not a readable value
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - line
        - \"notes.txt\"  # not a readable value
      children:
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: InBlock
              kind: expression
              text: \"{} in {}\"
              parameters:
                - word
                - line
          children:
            - block: PrintBlock
              kind: statement
              text: \"print {}\"
              parameters:
                - line"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

