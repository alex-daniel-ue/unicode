[node name="IT8EveryRowIsLonger" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForBlock (Integer)
      kind: nested
      text: \"for var {}, from {}\\nto {}, at step {}\"
      parameters:
        - row
        - 1
        - 4
        - 1
      children:
        - block: ForBlock (Integer)
          kind: nested
          text: \"for var {}, from {}\\nto {}, at step {}\"
          parameters:
            - seat
            - 1
            - row
            - 1
          children:
            - block: MoveBlock
              kind: statement
              text: \"move forward\"
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - right
        - block: MoveBlock
          kind: statement
          text: \"move forward\"
        - block: TurnBlock
          kind: statement
          text: \"turn {}\"
          parameters:
            - left"
room_goals = [NodePath("RoomGoals/GoalManager")]
star_slack = 2

[node name="LevelDescription" parent="." index="0"]
title = "Every row is longer"
mission = "Pick up every pen, row by row, then finish on the flag."
twist = "But every row of pens is longer than the one before it."
tip = "A for loop's start and end can be variables, not only numbers."

[node name="GenericBlockProvider" parent="." index="2"]
block_data = Array[ExtResource("4_block_data")]([ExtResource("3_for")])

