[node name="IT8EveryRowIsLonger" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them\nblock: BeginBlock\n  kind: nested\n  text: \"begin code\"\n  locked: true\n  children:\n    - block: ForBlock (Integer)\n      kind: nested\n      text: \"for var {}, from {}\\nto {}, at step {}\"\n      parameters:\n        - row\n        - 1\n        - 4\n        - 1\n      children:\n        - block: ForBlock (Integer)\n          kind: nested\n          text: \"for var {}, from {}\\nto {}, at step {}\"\n          parameters:\n            - seat\n            - 1\n            - row\n            - 1\n          children:\n            - block: MoveBlock\n              kind: statement\n              text: \"move forward\"\n        - block: TurnBlock\n          kind: statement\n          text: \"turn {}\"\n          parameters:\n            - right\n        - block: MoveBlock\n          kind: statement\n          text: \"move forward\"\n        - block: TurnBlock\n          kind: statement\n          text: \"turn {}\"\n          parameters:\n            - left"
room_goals = [NodePath("RoomGoals/GoalManager")]
star_slack = 2

[node name="Header" type="Label" parent="LevelDescription" index="0"]
theme_type_variation = &"HeaderMedium"
text = "Every row is longer"
horizontal_alignment = 1

[node name="Line1" type="Label" parent="LevelDescription" index="1"]
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "Four rows of seats. Each one is longer than the one above it."
autowrap_mode = 3

[node name="Line2" type="Label" parent="LevelDescription" index="2"]
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "The shape is the same as the last level -- a loop inside a loop -- but the inner loop can't run the same number of times on every pass."
autowrap_mode = 3

[node name="Line3" type="Label" parent="LevelDescription" index="3"]
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "The outer counter is a number like any other. You can type its NAME into the inner loop's bound instead of a number, and the inner loop will read whatever it holds on that pass."
autowrap_mode = 3

[node name="Line4" type="Label" parent="LevelDescription" index="4"]
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "The step down at the end of the body is turn right, move, turn left: down one row and facing right again. Keep it inside the loop. The last one lands on the door."
autowrap_mode = 3

[node name="Line5" type="Label" parent="LevelDescription" index="5"]
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "Nothing here is new. This is the whole module in one program."
autowrap_mode = 3

[node name="Line6" type="Label" parent="LevelDescription" index="6"]
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "13 pens. Miss one and the room isn't solved."
autowrap_mode = 3

[node name="Line7" type="Label" parent="LevelDescription" index="7"]
size_flags_horizontal = 3
theme = ExtResource("2_theme")
theme_type_variation = &"LegibleLabel"
text = "3 stars: 6 blocks."
autowrap_mode = 3

