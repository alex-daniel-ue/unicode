[node name="OP4HalfwayThere" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: MoveTilesBlock
      kind: statement
      text: \"step forward {} times\"
      parameters:
        - block: ArithmeticBlock
          kind: value
          text: \"{} {} {}\"
          parameters:
            - block: ConvertBlock
              kind: value
              text: \"{} ( {} )\"
              parameters:
                - int
                - \"input ( )\"  # not a readable value
            - //
            - 2"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

[node name="LevelDescription" parent="." index="0"]
title = "Halfway there"
mission = "The user types a number. The green flag is half that many tiles away, rounded down. Stop the robot on it."
rooms = PackedStringArray("The user types 8.", "The user types 5.", "The user types 6.")
twist = "Some numbers can't be split in half evenly."
tip = "In Python, `7 / 2` is 3.5, and `7 // 2` is 3."

