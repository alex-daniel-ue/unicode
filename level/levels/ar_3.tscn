[node name="AR3CountThenTheLast" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: MoveTilesBlock
      kind: statement
      text: \"move forward {} times\"
      parameters:
        - block: LengthOfBlock
          kind: value
          text: \"length of {}\"
          parameters:
            - route
    - block: TurnBlock
      kind: statement
      text: \"turn {}\"
      parameters:
        - left
    - block: MoveTilesBlock
      kind: statement
      text: \"move forward {} times\"
      parameters:
        - block: ItemOfBlock
          kind: value
          text: \"item {} of {}\"
          parameters:
            - block: ArithmeticBlock
              kind: value
              text: \"{} {} {}\"
              parameters:
                - block: LengthOfBlock
                  kind: value
                  text: \"length of {}\"
                  parameters:
                    - route
                - -
                - 1
            - route"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

[node name="LevelDescription" parent="." index="0"]
title = "Count, then the last"
mission = "Before the turn, go as far as the list is long. After the turn, go as far as its last value."
rooms = PackedStringArray("Three values.", "Two values.", "Four values.")
twist = "Every list has a different length."
blocks = Array[ExtResource("4_block_data")]([ExtResource("18_length_of"), ExtResource("19_arithmetic")])
block_notes = PackedStringArray("Counts the values in a list.", "Does math: + - * / // %")
block_values = PackedStringArray("list:route", "")
tip = "In Python, length of route is written len(route)."

