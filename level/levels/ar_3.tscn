[node name="AR3CountThenTheLast" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: MoveTilesBlock
      kind: statement
      text: \"step forward {} times\"
      parameters:
        - block: ArithmeticBlock
          kind: value
          text: \"{} {} {}\"
          parameters:
            - block: LengthOfBlock
              kind: value
              text: \"length of {}\"
              parameters:
                - route
            - -
            - 1
    - block: TurnBlock
      kind: statement
      text: \"turn {}\"
      parameters:
        - left
    - block: MoveTilesBlock
      kind: statement
      text: \"step forward {} times\"
      parameters:
        - block: ItemOfBlock
          kind: value
          text: \"index {} of {}\"
          parameters:
            - block: ArithmeticBlock
              kind: value
              text: \"{} {} {}\"
              parameters:
                - block: LengthOfBlock
                  kind: value
                  text: \"length of {}\"
                  parameters:
                    - route
                - -
                - 1
            - route"
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

[node name="LevelDescription" parent="." index="0"]
title = "Last index, last value"
block_notes = PackedStringArray("This block does math, like 3 + 1. Pick the sign in the middle. Either side can take a number, or the answer of another block.")
rooms = PackedStringArray("A list with three values.", "A list with two values.")
mission = "Before the turn, move as far as the last index of the list. After the turn, move as far as the last value in the list."
twist = "Each list has a different length."
blocks = Array[ExtResource("4_block_data")]([ExtResource("19_arithmetic")])
tip = "The Math block can use the answer of another block. In Python: `len(route) + 1`."

