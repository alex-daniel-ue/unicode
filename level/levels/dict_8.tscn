[node name="DICT8ThePriceList" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: ForEachBlock
      kind: nested
      text: \"for each {} in {}\"
      parameters:
        - item
        - prices
      children:
        - block: DeclareAsBlock
          kind: statement
          text: \"declare {} as {}\"
          parameters:
            - price
            - block: DictGetBlock
              kind: value
              text: \"{} [ {} ]\"
              parameters:
                - prices
                - item
        - block: PrintBlock
          kind: statement
          text: \"print {}\"
          parameters:
            - \"{item}: {price}\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2")]

[node name="LevelDescription" parent="." index="0"]
title = "The price list"
mission = "Show every thing in the prices dictionary, in order, each with its price, like pen: 15"
rooms = PackedStringArray("Three things.", "Two things.")
twist = "The shop sells different things in each room."
tip = "In Python, `for item in prices:` gives each key in turn."

