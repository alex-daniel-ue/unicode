[node name="OP10MinutesAndSeconds" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - secs
        - block: ConvertBlock
          kind: value
          text: \"{} ( {} )\"
          parameters:
            - int
            - \"input ( )\"  # not a readable value
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - mins
        - block: ArithmeticBlock
          kind: value
          text: \"{} {} {}\"
          parameters:
            - secs
            - //
            - 60
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - rest
        - block: ArithmeticBlock
          kind: value
          text: \"{} {} {}\"
          parameters:
            - secs
            - %
            - 60
    - block: PrintBlock
      kind: statement
      text: \"print {}\"
      parameters:
        - \"{mins} min {rest} s\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

