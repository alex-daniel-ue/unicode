[node name="SEL7NoSchoolToday" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - day
        - \"input ( )\"  # not a readable value
    - block: IfBlock
      kind: nested
      text: \"if {}\"
      parameters:
        - block: AndOrBlock
          kind: expression
          text: \"{} {} {}\"
          parameters:
            - block: ComparisonBlock
              kind: expression
              text: \"{} {} {}\"
              parameters:
                - day
                - ==
                - \"Saturday\"
            - or
            - block: ComparisonBlock
              kind: expression
              text: \"{} {} {}\"
              parameters:
                - day
                - ==
                - \"Sunday\"
      children:
        - block: PrintBlock
          kind: statement
          text: \"print {}\"
          parameters:
            - \"No school today!\"
    - block: ElseBlock
      kind: nested
      text: \"else\"
      children:
        - block: PrintBlock
          kind: statement
          text: \"print {}\"
          parameters:
            - \"Time for school.\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3")]

