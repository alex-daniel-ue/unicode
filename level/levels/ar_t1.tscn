[node name="ART1MoveMoreAtOnce" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: MoveTilesBlock
      kind: statement
      text: \"step forward {} times\"
      parameters:
        - 4"
room_goals = [NodePath("RoomGoals/GoalManager")]

[node name="LevelDescription" parent="." index="0"]
title = "Move more at once"
mission = "Stop the robot on the green flag. Count the tiles to the flag. Then type that number into the block."
