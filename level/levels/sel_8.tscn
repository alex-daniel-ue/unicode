[node name="SEL8AnIfInsideAnIf" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - n
        - block: ConvertBlock
          kind: value
          text: \"{} ( {} )\"
          parameters:
            - int
            - \"input ( )\"  # not a readable value
    - block: IfBlock
      kind: nested
      text: \"if {}\"
      parameters:
        - block: ComparisonBlock
          kind: expression
          text: \"{} {} {}\"
          parameters:
            - n
            - >
            - 0
      children:
        - block: IfBlock
          kind: nested
          text: \"if {}\"
          parameters:
            - block: ComparisonBlock
              kind: expression
              text: \"{} {} {}\"
              parameters:
                - block: ArithmeticBlock
                  kind: value
                  text: \"{} {} {}\"
                  parameters:
                    - n
                    - %
                    - 2
                - ==
                - 0
          children:
            - block: PrintBlock
              kind: statement
              text: \"print {}\"
              parameters:
                - \"Positive and even.\"
        - block: ElseBlock
          kind: nested
          text: \"else\"
          children:
            - block: PrintBlock
              kind: statement
              text: \"print {}\"
              parameters:
                - \"Positive and odd.\"
    - block: ElseBlock
      kind: nested
      text: \"else\"
      children:
        - block: PrintBlock
          kind: statement
          text: \"print {}\"
          parameters:
            - \"Zero or less.\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3"), NodePath("RoomGoals/GoalManagerRoom4")]

[node name="LevelDescription" parent="." index="0"]
title = "An if inside an if"
mission = "The user types a number. When it is more than 0, show whether it is even or odd: Positive and even. or Positive and odd. Otherwise, show Zero or less."
rooms = PackedStringArray("The user types 10.", "The user types 7.", "The user types -4.", "The user types 0.")
twist = "Even or odd only matters for numbers more than 0."
tip = "In Python, an if inside an if is indented one more step."

