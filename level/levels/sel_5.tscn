[node name="SEL5LetterGrades" node_paths=PackedStringArray("room_goals") instance=ExtResource("1_level")]
intended_solution = "# locked: true marks blocks the level placed; the student can't delete them
block: BeginBlock
  kind: nested
  text: \"begin code\"
  locked: true
  children:
    - block: DeclareAsBlock
      kind: statement
      text: \"declare {} as {}\"
      parameters:
        - score
        - block: ConvertBlock
          kind: value
          text: \"{} ( {} )\"
          parameters:
            - int
            - \"input ( )\"  # not a readable value
    - block: IfBlock
      kind: nested
      text: \"if {}\"
      parameters:
        - block: ComparisonBlock
          kind: expression
          text: \"{} {} {}\"
          parameters:
            - score
            - >=
            - 90
      children:
        - block: PrintBlock
          kind: statement
          text: \"print {}\"
          parameters:
            - \"Grade: A\"
    - block: ElifBlock
      kind: nested
      text: \"elif {}\"
      parameters:
        - block: ComparisonBlock
          kind: expression
          text: \"{} {} {}\"
          parameters:
            - score
            - >=
            - 80
      children:
        - block: PrintBlock
          kind: statement
          text: \"print {}\"
          parameters:
            - \"Grade: B\"
    - block: ElifBlock
      kind: nested
      text: \"elif {}\"
      parameters:
        - block: ComparisonBlock
          kind: expression
          text: \"{} {} {}\"
          parameters:
            - score
            - >=
            - 70
      children:
        - block: PrintBlock
          kind: statement
          text: \"print {}\"
          parameters:
            - \"Grade: C\"
    - block: ElseBlock
      kind: nested
      text: \"else\"
      children:
        - block: PrintBlock
          kind: statement
          text: \"print {}\"
          parameters:
            - \"Grade: F\""
room_goals = [NodePath("RoomGoals/GoalManager"), NodePath("RoomGoals/GoalManagerRoom2"), NodePath("RoomGoals/GoalManagerRoom3"), NodePath("RoomGoals/GoalManagerRoom4")]

[node name="LevelDescription" parent="." index="0"]
title = "Letter grades"
mission = "The user types a score. Show the grade: A for 90 and up, B for 80 and up, C for 70 and up, and F for less."
rooms = PackedStringArray("The user types 95.", "The user types 85.", "The user types 72.", "The user types 50.")
twist = "A score of 95 is also 80 and up, and 70 and up."
tip = "Python checks an if, then each elif, from the top down. It stops at the first one that is True."

