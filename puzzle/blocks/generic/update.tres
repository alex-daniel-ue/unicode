[resource]
script = ExtResource("1_data")
name = "UpdateBlock"
title = "Update"
color = Color(0.654902, 0.54509807, 0.98039216, 1)
base_path = "uid://demtvw17w06g5"
category = "Generic"
syntax = "{name: variable} {op: +=,-=,*=,/=,//=,%=} {value: variant}"
description = "Python's assignment operators: total += 5 is total = total + 5, and -=, *=, /=, //= and %= work the same way with their sign. The variable must already have a value. Follows the Math block's rules, so += also joins text."
note = "This block changes a variable by using its own value. total += 5 adds 5 to total."
text = "{} {} {}"
text_blocks = Array[ExtResource("1_data")]([ExtResource("6_name"), SubResource("Resource_op"), ExtResource("5_slot")])
text_hints = PackedStringArray("var", "", "value")
Function/script = ExtResource("4_script")
Function/entity_name = &""
Function/method = &"_update"
metadata/_custom_type_script = "uid://dbo3fa8pswxeg"
