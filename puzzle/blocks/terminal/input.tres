[resource]
script = ExtResource("1_data")
name = "InputBlock"
title = "Input"
color = Color(0.41960785, 0.84313726, 0.78431374, 1)
base_path = "uid://bxqygb1ofx6ql"
type = 3
socket = SubResource("Resource_socket")
value = SubResource("Resource_value")
category = "Terminal"
syntax = "input()"
description = "Reads the next line the user typed on the room's terminal and gives it as text (a string), like Python's input(). It always gives text, even when the user typed digits; int() or float() makes a number of it. Each input() reads the next line; reading more lines than the user typed is an error."
note = "This block gives the next line that the user typed. It always gives text, even when the user typed a number."
top_notch = false
text = "input ( )"
text_hints = PackedStringArray()
Type/value = SubResource("Resource_value")
Type/socket = SubResource("Resource_socket")
Function/script = ExtResource("4_script")
