category = "Value"
syntax = "{type: int/float/str}({value: variant})"
description = "Python's int(), float() and str(). int() makes a whole number from text like \"12\" (not \"12.5\") or drops a decimal number's fraction; float() makes a decimal number, so float(\"3\") is 3.0; str() makes text, the way print() writes the value."
note = "This block changes a value to another type. int makes a whole number, float makes a number with a decimal point, and str makes text."
