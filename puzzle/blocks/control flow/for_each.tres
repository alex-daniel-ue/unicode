type = 1
nested = SubResource("Resource_nested")
category = "Iterative"
syntax = "for each {name: variable} in {list: list}"
description = "Runs the blocks inside once for every item of a list, tuple or set, in order. The variable holds a copy of the item, so changing the variable doesn't change the list."
