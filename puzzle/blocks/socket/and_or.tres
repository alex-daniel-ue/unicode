[resource]
script = ExtResource("4_blockdata")
name = "AndOrBlock"
color = Color(0.2901961, 0.87058824, 0.5019608, 1)
base_path = "uid://pj76penmyeli"
type = 2
socket = SubResource("Resource_andor_socket")
category = "Boolean"
syntax = "{a: boolean} {op: and/or} {b: boolean}"
description = "Combines two conditions. With 'and' the whole thing is true only when both sides are true. With 'or' it is true when at least one side is true."
