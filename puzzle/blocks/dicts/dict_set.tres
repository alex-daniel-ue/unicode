[resource]
script = ExtResource("1_data")
name = "DictSetBlock"
title = "Set Key"
color = Color(0.76862746, 0.64705884, 1, 1)
base_path = "uid://demtvw17w06g5"
category = "Dicts"
syntax = "{dict}[{key}] = {value}"
description = "Python's d[key] = value: gives a key a new value, or adds the key with that value when the dictionary doesn't have it yet."
note = "This block gives a key a value. When the key isn't there yet, it adds it."
text = "set {} [ {} ] to {}"
text_blocks = Array[ExtResource("1_data")]([ExtResource("6_dict"), ExtResource("5_slot"), ExtResource("5_slot")])
text_hints = PackedStringArray("dict", "key", "value")
Function/script = ExtResource("4_script")
